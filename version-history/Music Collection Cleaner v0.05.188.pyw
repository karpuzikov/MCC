#releaseName { flex:1; min-width:0; font:var(--type-card-title); overflow-wrap:anywhere; }
#releasePath { flex:1 1 0; min-width:0; background:var(--canvas-soft); color:var(--body); border-radius:var(--radius); padding:var(--space-1); font:var(--type-secondary); overflow-wrap:anywhere; user-select:text; cursor:text; }
 .notice { color:var(--body); overflow-wrap:anywhere; white-space:pre-wrap; }
#releaseChoice { position:relative; display:inline-grid; grid-template-columns:repeat(3,minmax(46px,1fr)); gap:var(--space-1); padding-top:0; flex:none; }
#releaseChoice button,#albumGroupSelect { height:var(--control-height); box-sizing:border-box; padding-block:0; }
