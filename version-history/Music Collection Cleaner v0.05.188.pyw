#details { flex:0 0 var(--details-width); min-width:0; min-height:0; display:none; flex-direction:column; border-left:1px solid var(--hairline); overflow:auto; }
#details.open { display:flex; }
#detailsInner { display:flex; flex-direction:column; min-height:0; }
