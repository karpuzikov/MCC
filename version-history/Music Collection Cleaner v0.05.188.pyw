function releaseFactsHtml(n,boxed) {
  const marks=releaseMarkerStates(n).map(function(m){
    return '<span class="'+(boxed?"mkBox":"mk")+(m.on?" on":"")+'" data-marker="'+m.text.slice(0,3)+'"'+(m.title?' title="'+esc(m.title)+'"':"")+'>'+esc(m.text)+'</span>';
  });
  return boxed?marks.join(""):marks.join('<span class="sl">/</span>');
}
function rowMarker(n) {
  const kind=changeKind(n);
  if(kind==="ignored") return {cls:"ignored",symbol:"&nbsp;",label:n.pendingReleaseIgnore?"Skip pending":(n.pendingReleaseRestore?"Keep pending":"Skip")};
  if(kind==="added") return {cls:"add",symbol:"+",label:"Add"};
  if(kind==="upgraded") return {cls:"upgrade",symbol:"↑",label:"Upgrade"};
  if(kind==="replacementSource"||kind==="removed"||n.kind==="duplicate") return {cls:"skip",symbol:"",label:"Skip"};
  return {cls:"keep",symbol:"",label:"Keep"};
}
function appendReleaseRow(host,n) {
  const row=document.createElement("div");
  const marker=rowMarker(n);
  row.className="releaseRow "+marker.cls+(n.pendingReleaseIgnore?" pendingIgnore":"")+(n.pendingReleaseRestore?" pendingRestore":"");
  row.dataset.id=String(n.id);
  row.setAttribute("role","button");
  row.tabIndex=0;
  row.title=String(n.path||n.name||"")+"\n"+marker.label+(n.reason?"\n"+String(n.reason):"");
  row.setAttribute("aria-label",String(n.name||"")+". "+marker.label+".");
  row.dataset.baseTitle=row.title;
  row.dataset.baseAriaLabel=row.getAttribute("aria-label");
  paintReanalyzeHighlight(row,n.id);
  const warn=(n.auditIssues||[]).length?'<span class="warnMark" title="Audio integrity or incomplete release">⚠︎</span>':
    (n.typeWarning?'<span class="warnMark" title="'+esc(n.typeWarning)+'">⚠︎</span>':"");
  row.innerHTML=(marker.symbol?'<span class="rowMarker '+marker.cls+'" aria-hidden="true">'+marker.symbol+'</span>':"")
    +'<span class="releaseName">'+esc(n.name)+'</span>'+warn
    +'<span class="releaseFacts">'+perfectMarkHtml(n)+releaseFactsHtml(n,false)+'</span>';
  function activateReleaseRow(){
    const details=document.getElementById("details");
    if(selectedId!=null && Number(selectedId)===Number(n.id) && details.classList.contains("open")) return;
    selectedId=Number(n.id); activeTrack=null; openDetails(n); updateRowHighlights(); scheduleConnections(); updateTrackMode();
  }
  row.onclick=activateReleaseRow;
  row.onkeydown=function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();activateReleaseRow();}};
  host.appendChild(row); rowEls.set(String(n.id),row);
}
function changeSection(list,label,items){
  const section=document.createElement("section");section.className="changeSection";
  const head=document.createElement("div");head.className="changeSectionHead";head.textContent=label+" · "+items.length;
  const rows=document.createElement("div");rows.className="releaseRows";
  section.append(head,rows);
  items.forEach(function(n){appendReleaseRow(rows,n);});
  list.appendChild(section);
}
function renderChangesBoard(nodes) {
  const columns=document.getElementById("columns");
  document.getElementById("boardContent").classList.add("changesContent");
  columns.className="changesMode";
  const list=document.createElement("div");
  list.id="changeList";
  const q=document.getElementById("search").value.trim();
  if(q){
    changeSection(list,"Search",searchMatchesFor(q));
  } else {
    let shown=0;
    [["added","Added"],["upgraded","Upgraded"],["removed","Removed"],["ignored","Skip"]].forEach(function(spec){
      if(changeFilter!=="all"&&changeFilter!==spec[0])return;
      const items=nodes.filter(function(n){return changeKind(n)===spec[0];});
      if(!items.length)return;
      shown+=items.length;
      changeSection(list,spec[1],items);
    });
    if(!shown){
      const empty=document.createElement("div");empty.className="changeEmpty";empty.textContent="No changes";
      list.appendChild(empty);
    }
  }
  columns.appendChild(list);
}
function renderFullBoard(nodes) {
  const columns=document.getElementById("columns");
  document.getElementById("boardContent").classList.remove("changesContent");
  columns.className="fullMapColumns";
  // One column per release type; the columns share the free width.
  [{key:"album",label:"Albums"},{key:"ep",label:"EPs"},{key:"single",label:"Singles"},
   {key:"anthology",label:"Anthologies"},{key:"compilation",label:"Compilations"}].forEach(function(def){
    const typed=nodes.filter(function(n){return releaseColumnKind(n)===def.key;});
    if(!typed.length)return;
    const col=document.createElement("section");
    col.className="releaseColumn";
    col.dataset.kind=def.key;
    const head=document.createElement("div");
    head.className="releaseColumnHeader";
    head.textContent=def.label+" · "+typed.length;
    const flow=document.createElement("div");
    flow.className="releaseGroups";
    const grouped=new Map();
    typed.forEach(function(n){
      const key=groupKeyForNode(n);
      if(!grouped.has(key))grouped.set(key,[]);
      grouped.get(key).push(n);
    });
    Array.from(grouped.values()).sort(function(a,b){return nodes.indexOf(a[0])-nodes.indexOf(b[0]);}).forEach(function(items){
      const group=document.createElement("div");group.className="releaseGroup";
      const title=document.createElement("div");title.className="releaseGroupTitle";
      title.textContent=groupTitleForNodes(items);
      title.classList.toggle("allSkipped",items.every(n=>["skip","ignored"].includes(rowMarker(n).cls) && !n.pendingReleaseRestore));
      const rows=document.createElement("div");rows.className="releaseRows";
      items.forEach(function(n){appendReleaseRow(rows,n);});
      group.append(title,rows);flow.appendChild(group);
    });
    col.append(head,flow);
    columns.appendChild(col);
  });
}
function renderBoard() {
  if(!state)return;
  const columns=document.getElementById("columns");
  columns.innerHTML="";rowEls=new Map();
  const nodes=state.nodes||[];
  renderChangeSummary();
  if(viewMode==="changes")renderChangesBoard(nodes);else renderFullBoard(nodes);
  updateRowHighlights();scheduleConnections();
}
function updateTrackMode() {
  const mode=document.getElementById("modeText");
  if(activeTrack){
    const carriers=carriersForGroup(activeTrack.groupId);
    mode.textContent='"'+activeTrack.title+'" - '+carriers.length+' release(s)';
  } else {
    const q=document.getElementById("search").value.trim();
    const matches=searchMatchesFor(q);
    mode.textContent=q
      ? 'Find "'+q+'" - '+matches.length+' release(s)'
      : "";
  }
}
function selectTrack(releaseId,track) {
  if(Number(track.groupId)<0) return;
  selectedId=Number(releaseId);
  const same=activeTrack&&activeTrack.releaseId===Number(releaseId)&&activeTrack.groupId===Number(track.groupId);
  activeTrack=same?null:{releaseId:Number(releaseId),groupId:Number(track.groupId),title:String(track.title||"")};
  if(viewMode!=="full"){viewMode="full";renderChangeSummary();renderBoard();}
  updateRowHighlights(); scheduleConnections(); updateTrackMode();
  document.querySelectorAll(".track").forEach(function(el){
    el.classList.toggle("activeTrack",!!activeTrack&&Number(el.dataset.group)===Number(activeTrack.groupId));
  });
}
function alternativesForTrack(t,wantFamily) {
  if(!state || !state.versionFamilies || !t || !t.baseKey) return [];
  const family=state.versionFamilies[t.baseKey]||[];
  return family.filter(function(v){
    if(Number(v.groupId)===Number(t.groupId)) return false;
    if(t.artistKey && (v.artistKeys||[]).length && !v.artistKeys.includes(t.artistKey)) return false;
    return String(v.family||"version")===String(wantFamily);
  });
}
function versionsForTrack(t) {
  const family=t.family||(t.isLive?"live":t.isRemix?"remix":"version");
  if(family==="remix"){
    return alternativesForTrack(t,"remix").filter(v=>t.remixKey&&(v.remixKeys||[]).includes(t.remixKey));
  }
  return family==="version"?alternativesForTrack(t,"version"):[];
}
function versionLengthDelta(t,other){
  const a=Number(t&&t.durationSeconds),b=Number(other&&other.durationSeconds);
  if(!Number.isFinite(a)||!Number.isFinite(b)||a<=0||b<=0)return null;
  const delta=Math.abs(a-b);
  return delta>8.0000001 ? delta : null;
}
function lengthDeltaText(seconds){
  return "\u0394"+(Math.round(seconds*10)/10).toFixed(1)+"s";
}
function remixesForTrack(t) {
  return alternativesForTrack(t,"remix").filter(v=>!t.remixKey||!(v.remixKeys||[]).includes(t.remixKey));
}
function liveForTrack(t) { return alternativesForTrack(t,"live"); }
function highlightAlternativeVersion(v) {
  if(!v || Number(v.groupId)<0 || Number(v.releaseId)<0) return;
  if(viewMode!=="full"){viewMode="full";renderChangeSummary();renderBoard();}
  activeTrack={
    releaseId:Number(v.releaseId),targetId:Number(v.releaseId),
    groupId:Number(v.groupId),
    title:String(v.title||"Alternative version")
  };
  updateRowHighlights(); scheduleConnections(); updateTrackMode();
  document.querySelectorAll(".track").forEach(function(el){
    el.classList.toggle("activeTrack",!!activeTrack&&Number(el.dataset.group)===Number(activeTrack.groupId));
  });
  const row=rowEls.get(String(v.releaseId));
  if(row) row.scrollIntoView({behavior:"smooth",block:"center",inline:"center"});
}
function exclusionStatus(t) { // left out of the Keep/Skip decision; still copied with its release
  const reason=String(t.exclusionReason||"").trim();
  if(reason==="Explicit>Clean") return "Not compared: Explicit > Clean";
  if(reason) return "Not compared: "+reason;
  if(t.isRemix&&t.isLive) return "Not compared: Remix / Live";
  if(t.isRemix) return "Not compared: Remix";
  if(t.isLive) return "Not compared: Live";
  return "Not compared";
}
function trackStatus(t,n) {
  if(t.pendingIgnore) return (Number(t.groupId)>=0?"Skip recording everywhere":"Skip this track")+" · Updating";
  if(t.pendingRestore) return (Number(t.groupId)>=0?"Keep this recording everywhere":"Keep this track")+" · Updating";
  if(t.manualSkip) return Number(t.groupId)>=0?"Skip this recording everywhere":"Skip this track";
  if(n && n.manualRemoved){
    if(t.excluded) return exclusionStatus(t);
    if(t.orphaned || !t.replacementSource) return "NO REPLACEMENT - exact recording is not retained elsewhere";
    const more=(t.replacementAlternates||[]).length;
    return (t.coveredByAlternateVersion?"Covered by alternate version: ":"Sourced from: ")+t.replacementSource+(more?" (+"+more+" other retained cop"+(more===1?"y":"ies")+")":"");
  }
  if(t.excluded) return exclusionStatus(t);
  if(t.orphaned) return "No verified replacement - removal would lose it";
  if(t.coveredBy && t.coveredBy.length) return (t.coveredByAlternateVersion?"Replaceable version on: ":"Also on: ")+t.coveredBy.slice(0,2).join("; ");
  const matched=Math.max(0,Number(t.audioMatchEditions)||0);
  const unverified=Math.max(0,Number(t.unverifiedEditions)||0);
  if(matched||unverified){
    const parts=[];
    if(matched) parts.push("Same audio on "+matched+" edition"+(matched===1?"":"s"));
    if(unverified) parts.push("Also listed on "+unverified+" edition"+(unverified===1?"":"s")+" (audio unverified)");
    return parts.join("; ");
  }
  if(t.unique) return "Unique to this release";
  if(t.isGem) return "Gem - no duplicates or other versions";
  if(t.distinction) return t.distinction;
  return "Included";
}
function trackNote(t,n) {
  const category=t.isRemix?"Remix":(t.isLive?"Live":"");
  if(n.kind==="duplicate" && !t.manualSkip && !t.excluded && !t.orphaned && !t.coveredByAlternateVersion &&
      ((t.coveredBy||[]).length || t.replacementSource || t.audioMatchEditions)) return "Duplicate · Skip";
  const stateLabel=t.manualSkip||t.pendingIgnore?"Skip":t.pendingRestore?"Updating":
    t.excluded&&!category?"Not compared":t.orphaned?"No replacement":"";
  return [category,stateLabel].filter(Boolean).join(" · ");
}
function closeDetails() {
  selectedId=null;
  activeTrack=null;
  const aside=document.getElementById("details");
  aside.classList.remove("open");
  updateRowHighlights();
  scheduleConnections();
  updateTrackMode();
}
function closeTrackMenus() {
  document.querySelectorAll("#details .track.menuOpen").forEach(function(row){row.classList.remove("menuOpen");});
}
document.addEventListener("click",closeTrackMenus);
document.addEventListener("keydown",function(ev){if(ev.key==="Escape")closeTrackMenus();});
function discNumbering(tracks) {
  // Numbers restart per disc: a disc whose tags continue the previous disc's count is shifted to start at 1.
  const minByDisc=new Map();
  tracks.forEach(function(t){
    const d=Number(t.disc||1), num=parseInt(t.number,10);
    if(Number.isFinite(num))minByDisc.set(d,Math.min(minByDisc.has(d)?minByDisc.get(d):num,num));
  });
  return function(t){
    const d=Number(t.disc||1), num=parseInt(t.number,10);
    if(!Number.isFinite(num))return String(t.number||"");
    const min=minByDisc.get(d)||1;
    return String(d>1&&min>1?num-min+1:num);
  };
}
function trackNoteHtml(t,note) { // the gem sits in the note column, before the note
  return (t.isGem?'<span class="trackGem" role="img" aria-label="Gem: no duplicates or other versions" title="Gem: no duplicates or other versions">{{icon:gem}}</span>':"")+esc(note);
}
function openDetails(n) {
  const aside=document.getElementById("details"), inner=document.getElementById("detailsInner");
  const opening=!aside.classList.contains("open");
  const allTracks=n.tracks||[];
  const discCount=new Set(allTracks.map(function(t){return Number(t.disc||1);})).size;
  const shownNumber=discNumbering(allTracks);
  let lastDisc=null;
  let tracks="";
  allTracks.forEach(function(t){
    const disc=Number(t.disc||1);
    if(discCount>1&&disc!==lastDisc)tracks+='<div class="discHead">Disc '+disc+'</div>';
    lastDisc=disc;
    const cls=["track"]; if(t.orphaned) cls.push("orphan"); else if(t.unique&&!t.excluded&&!t.manualSkip) cls.push("unique");
    if(t.excluded) cls.push("skipped");
    if(t.manualSkip||t.pendingIgnore||t.pendingRestore) cls.push("manual");
    if(activeTrack && Number(t.groupId)>=0 && Number(activeTrack.groupId)===Number(t.groupId)) cls.push("activeTrack");
    let action="";
    // Persisted ignored tracks remain restorable after Re-scan even though their exclusion flag is now true.
    if(state.editable){
      const skipped=!!(t.manualSkip||t.pendingIgnore);
      const label=skipped?"Keep":"Skip";
      if(skipped||!t.excluded||t.pendingRestore)
        action='<button class="ignoreTrack" data-track="'+t.index+'" aria-label="'+label+(Number(t.groupId)>=0?' this recording everywhere':' this track')+'">'+label+'</button>';
    }
    const versions=versionsForTrack(t), remixes=remixesForTrack(t), live=liveForTrack(t);
    let tags="";
    if(versions.length) tags+='<button class="btn small tagBtn versionsTrack" data-track="'+t.index+'" aria-expanded="false">Versions '+versions.length+'</button>';
    if(remixes.length) tags+='<button class="btn small tagBtn remixesTrack" data-track="'+t.index+'" aria-expanded="false">Remixes '+remixes.length+'</button>';
    if(live.length) tags+='<button class="btn small tagBtn liveTrack" data-track="'+t.index+'" aria-expanded="false">Live '+live.length+'</button>';
    const names={remix:"Remix",live:"Live",skip:"Skip"};
    const badge=t.patternKind&&t.patternKind!=="normal"?
      '<button class="patternBadge" data-track="'+t.index+'" title="Move to Personal Picks" aria-label="Move '+esc(names[t.patternKind]||"pattern")+' to Personal Picks">To Personal Picks</button>':"";
    const actions=state.editable?
      '<span class="trackActionGroup" role="menu">'+["remix","live"].map(function(kind){
        const selected=t.patternKind===kind;
        return '<button class="patternMark" role="menuitemcheckbox" aria-checked="'+selected+'" data-track="'+t.index+'" data-kind="'+(selected?"clear":kind)+'">'+(selected?"✓ ":"")+names[kind]+'</button>';
      }).join("")+action+badge+'</span>':"";
    const statusText=trackStatus(t,n);
    const advisory=String(t.explicitState||"unknown").toLowerCase();
    const indicator=advisory==="explicit"?"E":(advisory==="clean"?"C":"");
    const advisoryName=indicator?(indicator==="E"?"Explicit":"Clean"):"";
    const advisoryBadge=indicator?'<span class="advisoryBadge" title="'+advisoryName+'">'+indicator+'</span>':"";
    const note=trackNote(t,n);
    tracks+='<div class="'+cls.join(" ")+'" role="button" tabindex="0" aria-label="Inspect track '+esc(t.title)+'" data-group="'+t.groupId+'" data-index="'+t.index+'" title="'+esc(statusText)+'">'
      +'<span class="num">'+esc(shownNumber(t))+'</span><span class="titleText">'+esc(t.title)+advisoryBadge
+'</span>'
      +'<span class="trackTags">'+tags+'</span><span class="note" title="'+esc(statusText)+'">'+trackNoteHtml(t,note)+'</span>'
      +'<span class="dur">'+esc(t.duration)+'</span>'
      +(state.editable?'<button class="iconBtn rowMenuBtn" aria-label="Track actions" aria-haspopup="true" title="Track actions">{{icon:dots}}</button>'+actions:"")+'</div>';
    function panel(items,kind,heading,cls){
      if(!items.length) return "";
      let rows="";
      const sorted=kind==="version"?[...items].sort((a,b)=>String(a.title).localeCompare(String(b.title),undefined,{numeric:true,sensitivity:"base"})
        || (Number(a.durationSeconds)||Infinity)-(Number(b.durationSeconds)||Infinity)):items;
      sorted.forEach(function(v){
        const stateText=v.retained?"Keep":(v.available?"Available":"Skip");
        const stateClass=v.retained?"retained":(v.available?"available":"");
        const releaseText=(v.retainedReleaseNames&&v.retainedReleaseNames.length?v.retainedReleaseNames:v.releaseNames||[]).join("; ");
        const delta=kind==="version"?versionLengthDelta(t,v):null;
        rows+='<button class="altVersion" data-kind="'+kind+'" data-parent="'+t.index+'" data-group="'+v.groupId+'" data-release="'+v.releaseId+'" title="'+esc(releaseText)+'">'
          +'<span class="altTitle">'+esc(v.title)+'</span><span class="altDuration'+(delta!==null?' changed':'')+'">'+esc(v.duration||"")
          +(delta!==null?' '+lengthDeltaText(delta):'')+'</span><span class="altState '+stateClass+'">'+esc(stateText)+'</span></button>';
      });
