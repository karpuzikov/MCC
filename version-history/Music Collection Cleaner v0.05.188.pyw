.track.unique .note { color:var(--primary); }
.trackGem { flex:none; color:var(--primary); display:inline-flex; }
.track .dur { width:36px; text-align:right; font:var(--type-mono-body); color:var(--body); }
.track.unique .dur.differentLength,.track.unique .lengthDelta,.altDuration.changed { color:var(--status-length); }
.lengthDelta { flex:none; font:var(--type-chip); }
.rowMenuBtn { color:var(--body); }
.track .rowMenuBtn { min-width:24px; min-height:24px; }
.track .tagBtn { min-height:22px; }
.trackActionGroup { position:fixed; z-index:50; display:none; flex-direction:column; padding:var(--space-1); background:var(--canvas-soft); border-radius:var(--radius); }
.track.menuOpen .trackActionGroup { display:flex; }
.trackActionGroup button { display:block; text-align:left; padding:var(--space-1); border-radius:4px; font:var(--type-button); color:var(--ink); white-space:nowrap; }
.trackActionGroup button:hover { background:var(--hairline); }
.trackPanel { display:none; flex-direction:column; margin:0 0 var(--space-1) calc(var(--space-3) + var(--space-2)); padding:var(--pad-tight); background:var(--canvas-soft); border-radius:var(--radius); }
.trackPanel.open { display:flex; }
.trackPanelHead { font:var(--type-table-header); text-transform:uppercase; color:var(--body); padding:var(--pad-tight); }
.altVersion { display:flex; align-items:center; gap:var(--space-2); width:100%; padding:var(--pad-tight); border-top:1px solid var(--hairline); font:var(--type-body); text-align:left; }
.altVersion:hover .altTitle { color:var(--primary); }
.altTitle { flex:1; min-width:0; overflow-wrap:anywhere; color:var(--ink); }
.altDuration { flex:none; font:var(--type-mono-body); color:var(--mute); }
.altState { flex:none; width:58px; text-align:right; font:var(--type-chip); color:var(--mute); }
.altState.retained { color:var(--ink); }
.altState.available { color:var(--status-added); }

#stepSave { position:relative; border-top:1px solid var(--hairline); display:flex; flex-direction:column; gap:var(--space-2); }
#exportModeBtn { gap:var(--space-1); border-color:transparent; padding:var(--space-1); }
#exportModeBtn .icon { color:var(--primary-soft); }
#exportPath { flex:1 1 0; }
"""

