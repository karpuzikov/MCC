  const pending=Number(state.pendingPatternCount||0);
  const savedPicks=Number(state.personalCount||0);
  document.getElementById("personalPicks").textContent="Keeps and Skips"
    +((savedPicks||pending)?" ("+[savedPicks?String(savedPicks):"",pending?pending+" new":""].filter(Boolean).join(" · ")+")":"");
  document.getElementById("progressStatus").textContent=state.status||"Ready";
  const pct=Math.max(0,Math.min(100,Number(state.progressPct||0)));
