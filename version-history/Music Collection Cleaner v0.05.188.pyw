function carriersForGroup(groupId) {
  if (groupId == null || Number(groupId) < 0) return [];
  return (state.nodes || []).filter(function(n) {
    return (n.tracks || []).some(function(t){ return Number(t.groupId) === Number(groupId); });
  });
