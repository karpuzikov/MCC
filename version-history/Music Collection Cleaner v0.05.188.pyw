# ---------------------------------------------------------------------------
# Physical-size scaling: 1 CSS px = 0.2645 mm on every monitor.
# ---------------------------------------------------------------------------
CSS_PX_TARGET_MM = 0.2645
CSS_ZOOM_RANGE = (0.75, 2.0)
UI_SIZE_PERCENT_CHOICES = tuple(range(80, 151, 10))
PLAUSIBLE_PIXELS_PER_INCH = (80.0, 350.0)  # TVs often report fake sizes (e.g. 160 cm)
MIN_WINDOW_CSS_PX = (1024, 720)


def _ui_size_percent(settings: dict) -> int:
    try:
        value = int(settings.get("ui_size_percent", 100))
    except (TypeError, ValueError):
        return 100
    return value if value in UI_SIZE_PERCENT_CHOICES else 100


def _store_ui_size_percent(value) -> None:
    data = _load_app_settings()
    data["ui_size_percent"] = _ui_size_percent({"ui_size_percent": value})
    _atomic_write_json(_settings_path(), data)


def _css_zoom_factor(physical_width_mm: Optional[float], native_width_px: int,
                     windows_scale: float, ui_size_percent: int) -> Tuple[float, bool, Optional[float]]:
    """(WebView2 ZoomFactor, display size accepted, mm per CSS px before zoom) for one monitor.

    One CSS px covers windows_scale device pixels before zoom, so it is
    physical_width_mm / native_width_px * windows_scale millimetres wide.
    """
    ui_size = _ui_size_percent({"ui_size_percent": ui_size_percent}) / 100.0
    if not physical_width_mm or native_width_px <= 0 or windows_scale <= 0:
        return ui_size, False, None
    pixels_per_inch = native_width_px / (physical_width_mm / 25.4)
    if not PLAUSIBLE_PIXELS_PER_INCH[0] <= pixels_per_inch <= PLAUSIBLE_PIXELS_PER_INCH[1]:
        return ui_size, False, None
    mm_per_css_px = physical_width_mm / native_width_px * windows_scale
    zoom = min(CSS_ZOOM_RANGE[1], max(CSS_ZOOM_RANGE[0], CSS_PX_TARGET_MM / mm_per_css_px))
    return zoom * ui_size, True, mm_per_css_px


_DISPLAY_WIDTH_MM_CACHE: Dict[str, Tuple[Optional[float], str]] = {}
_DISPLAY_LOG_SINK = None
_CSS_ZOOM_WINDOWS: List[object] = []


def _set_display_log_sink(sink) -> None:
    global _DISPLAY_LOG_SINK
    _DISPLAY_LOG_SINK = sink


def _log_display(message: str) -> None:
    if _DISPLAY_LOG_SINK is not None:
        try:
            _DISPLAY_LOG_SINK(message)
        except Exception:
            pass


def _monitor_instance_path(device_interface: str) -> str:
    r"""\\?\DISPLAY#GSM5B08#5&2b&0&UID4353#{guid} -> DISPLAY\GSM5B08\5&2b&0&UID4353."""
    parts = device_interface.replace("\\\\?\\", "").split("#")
    return "\\".join(parts[:3]) if len(parts) >= 3 else ""


def _display_width_mm_from_wmi(instance_path: str) -> Optional[float]:
    command = ("Get-CimInstance -Namespace root\\wmi -ClassName WmiMonitorBasicDisplayParams | "
               "ForEach-Object { $_.InstanceName + '|' + $_.MaxHorizontalImageSize }")
    try:
        out = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", command],
                             capture_output=True, text=True, timeout=8,
                             creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0)).stdout
    except Exception:
        return None
    for line in out.splitlines():
        name, _, cm = line.strip().rpartition("|")
        if name.upper().startswith(instance_path.upper()) and cm.strip().isdigit() and int(cm) > 0:
            return int(cm) * 10.0
    return None


def _display_width_mm_from_edid(instance_path: str) -> Optional[float]:
    try:
        import winreg
        with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE,
                            "SYSTEM\\CurrentControlSet\\Enum\\" + instance_path + "\\Device Parameters") as key:
            edid = bytes(winreg.QueryValueEx(key, "EDID")[0])
    except Exception:
        return None
    # EDID byte 21: maximum horizontal image size in cm.
    return edid[21] * 10.0 if len(edid) > 22 and edid[21] else None


def _display_width_mm(instance_path: str, native_px: Tuple[int, int]) -> Tuple[Optional[float], str]:
    """(physical width in mm, source): WMI, else EDID."""
    if instance_path not in _DISPLAY_WIDTH_MM_CACHE:
        wmi = _display_width_mm_from_wmi(instance_path) if instance_path else None
        edid = None if wmi else (_display_width_mm_from_edid(instance_path) if instance_path else None)
        _DISPLAY_WIDTH_MM_CACHE[instance_path] = (wmi, "WMI") if wmi else ((edid, "EDID") if edid else (None, "none"))
    return _DISPLAY_WIDTH_MM_CACHE[instance_path]


def _window_monitor_metrics(hwnd: int) -> Optional[Tuple[int, str, Tuple[int, int], float]]:
    """(monitor handle, monitor instance path, current pixel size, Windows scale) for a window."""
    import ctypes
    from ctypes import wintypes

    class MONITORINFOEXW(ctypes.Structure):
        _fields_ = [("cbSize", wintypes.DWORD), ("rcMonitor", wintypes.RECT), ("rcWork", wintypes.RECT),
                    ("dwFlags", wintypes.DWORD), ("szDevice", wintypes.WCHAR * 32)]

    class DEVMODEW(ctypes.Structure):
        _fields_ = [("dmDeviceName", wintypes.WCHAR * 32), ("dmSpecVersion", wintypes.WORD),
                    ("dmDriverVersion", wintypes.WORD), ("dmSize", wintypes.WORD), ("dmDriverExtra", wintypes.WORD),
                    ("dmFields", wintypes.DWORD), ("dmUnion", ctypes.c_byte * 16), ("dmColor", ctypes.c_short),
                    ("dmDuplex", ctypes.c_short), ("dmYResolution", ctypes.c_short), ("dmTTOption", ctypes.c_short),
                    ("dmCollate", ctypes.c_short), ("dmFormName", wintypes.WCHAR * 32), ("dmLogPixels", wintypes.WORD),
                    ("dmBitsPerPel", wintypes.DWORD), ("dmPelsWidth", wintypes.DWORD), ("dmPelsHeight", wintypes.DWORD),
                    ("dmDisplayFlags", wintypes.DWORD), ("dmDisplayFrequency", wintypes.DWORD),
                    ("dmICMMethod", wintypes.DWORD), ("dmICMIntent", wintypes.DWORD), ("dmMediaType", wintypes.DWORD),
                    ("dmDitherType", wintypes.DWORD), ("dmReserved1", wintypes.DWORD), ("dmReserved2", wintypes.DWORD),
                    ("dmPanningWidth", wintypes.DWORD), ("dmPanningHeight", wintypes.DWORD)]

    class DISPLAY_DEVICEW(ctypes.Structure):
        _fields_ = [("cb", wintypes.DWORD), ("DeviceName", wintypes.WCHAR * 32), ("DeviceString", wintypes.WCHAR * 128),
                    ("StateFlags", wintypes.DWORD), ("DeviceID", wintypes.WCHAR * 128), ("DeviceKey", wintypes.WCHAR * 128)]

    user32, shcore = ctypes.windll.user32, ctypes.windll.shcore
    user32.MonitorFromWindow.restype = wintypes.HMONITOR
    monitor = user32.MonitorFromWindow(wintypes.HWND(hwnd), 2)  # MONITOR_DEFAULTTONEAREST
    if not monitor:
        return None
    info = MONITORINFOEXW(cbSize=ctypes.sizeof(MONITORINFOEXW))
    if not user32.GetMonitorInfoW(monitor, ctypes.byref(info)):
        return None
    mode = DEVMODEW(dmSize=ctypes.sizeof(DEVMODEW))
    if not user32.EnumDisplaySettingsW(info.szDevice, -1, ctypes.byref(mode)):  # ENUM_CURRENT_SETTINGS
        return None
    dpi_x, dpi_y = wintypes.UINT(), wintypes.UINT()
    if shcore.GetDpiForMonitor(monitor, 0, ctypes.byref(dpi_x), ctypes.byref(dpi_y)) != 0:  # MDT_EFFECTIVE_DPI
        return None
    device = DISPLAY_DEVICEW(cb=ctypes.sizeof(DISPLAY_DEVICEW))
    instance = ""
    if user32.EnumDisplayDevicesW(info.szDevice, 0, ctypes.byref(device), 1):  # EDD_GET_DEVICE_INTERFACE_NAME
        instance = _monitor_instance_path(device.DeviceID)
    return int(monitor), instance, (int(mode.dmPelsWidth), int(mode.dmPelsHeight)), dpi_x.value / 96.0


def _apply_css_zoom(window, metrics: Tuple[int, str, Tuple[int, int], float]) -> None:
    monitor, instance, native_px, scale = metrics
    width_mm, source = _display_width_mm(instance, native_px)
    zoom, known, mm_per_css_px = _css_zoom_factor(width_mm, native_px[0], scale, _ui_size_percent(_load_app_settings()))
    if known:  # most monitors report no usable size; Windows scaling then applies silently
        _log_display("Display %s: %.0f mm (%s), %d px, Windows scale %.2f, %.4f mm/CSS px, ZoomFactor %.2f" % (
            instance or monitor, width_mm, source, native_px[0], scale, mm_per_css_px, zoom))
    form = window.native
    from System import Action
    from System.Drawing import Size

    def _set():
        form.browser.webview.ZoomFactor = zoom
        frame_w = form.Size.Width - form.ClientSize.Width
        frame_h = form.Size.Height - form.ClientSize.Height
        device_px_per_css_px = zoom * scale
        form.MinimumSize = Size(round(MIN_WINDOW_CSS_PX[0] * device_px_per_css_px) + frame_w,
                                round(MIN_WINDOW_CSS_PX[1] * device_px_per_css_px) + frame_h)

    form.Invoke(Action(_set))


def _start_css_zoom_watcher(window) -> None:
    """Apply the zoom now and again whenever the window's monitor, resolution or DPI changes."""
    if os.name != "nt":
        return
    _CSS_ZOOM_WINDOWS.append(window)
    window.__dict__["_css_zoom_metrics"] = None
    closed = threading.Event()
    window.events.closed += closed.set

    def _watch():
        try:
            from System import Func, Int64
            hwnd = int(window.native.Invoke(Func[Int64](lambda: window.native.Handle.ToInt64())))
        except Exception:
            return
        while not closed.is_set():
            try:
                metrics = _window_monitor_metrics(hwnd)
                if metrics and metrics != window.__dict__.get("_css_zoom_metrics"):
                    window.__dict__["_css_zoom_metrics"] = metrics
                    _apply_css_zoom(window, metrics)
            except Exception:
                pass
            closed.wait(1.0)
        if window in _CSS_ZOOM_WINDOWS:
            _CSS_ZOOM_WINDOWS.remove(window)

    threading.Thread(target=_watch, name="CSS zoom watcher", daemon=True).start()


def _apply_css_zoom_to_open_windows() -> None:
    """Re-apply after the UI size setting changed."""
    for window in list(_CSS_ZOOM_WINDOWS):
        metrics = window.__dict__.get("_css_zoom_metrics")
        if metrics:
            try:
                _apply_css_zoom(window, metrics)
            except Exception:
                pass


