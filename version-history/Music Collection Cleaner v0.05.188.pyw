    }).join("")+(n.manualGroupAssigned?'<option value="-1">Automatic group</option>':"");
    if(options)albumGroupActions='<select id="albumGroupSelect" aria-label="Move to group" title="Move to group"><option value="" selected disabled>Move to group</option>'+options+'</select>';
  }
  let notices="";
