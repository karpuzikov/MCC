      const rows=folderRows();
      if(i<2)rows[i].path="";else rows.splice(i,1);
      pushFolders(rows);
    });
    [star,label,input,browse,open,clear].forEach(function(el){row.appendChild(el);});
    host.appendChild(row);
  });
