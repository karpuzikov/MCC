    +'<div id="factsRow"><div id="releaseFacts">'+perfectMarkHtml(n)+releaseFactsHtml(n,true)+'</div>'+choiceGroup+albumGroupActions+'</div>'
    +'<div id="pathRow"><div id="releasePath" role="textbox" aria-readonly="true" tabindex="0" aria-label="Release folder path">'+esc(n.path)+'</div>'
    +'<button class="iconBtn" id="openFolderBtn" title="Show in Explorer" aria-label="Show in Explorer">{{icon:explorer}}</button></div>'+notices+'</div>'
    +'<div id="tracks">'+tracks+'</div>';
  aside.classList.add("open");
  if(opening) requestAnimationFrame(scheduleConnections);
  document.getElementById("closeDetailsBtn").onclick=closeDetails;
  document.getElementById("openFolderBtn").onclick=function(){bridge.openFolder(n.path);};
  inner.querySelectorAll("#releaseChoice button").forEach(btn=>{
    btn.onclick=()=>bridge.setReleaseChoice(Number(n.id),btn.dataset.choice,receiveReleaseToggle);
  });
  document.getElementById("releasePath").onkeydown=function(ev){
    if((ev.ctrlKey||ev.metaKey) && ev.key.toLowerCase()==="a"){
