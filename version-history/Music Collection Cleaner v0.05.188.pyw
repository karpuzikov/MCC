  const box=document.getElementById("activity");
  const atBottom=box.scrollHeight-box.scrollTop-box.clientHeight<30;
  box.textContent=(state.activity||[]).join("\n");
  if(atBottom)box.scrollTop=box.scrollHeight;
  const busy=!!state.running||!!state.reviewPending||!!state.mapOpen;
  const working=!!state.running||!!state.reviewPending;
  const scanBtn=document.getElementById("analyzeBtn"), mapBtn=document.getElementById("mapBtn");
  scanBtn.disabled=busy;
  document.getElementById("fullScanBtn").disabled=busy;
  document.getElementById("undoBtn").disabled=working;
  mapBtn.disabled=!state.mapAvailable||(working&&!document.getElementById("mapFrame").srcdoc);
  document.getElementById("mapTitle").disabled=mapBtn.disabled;
  document.getElementById("viewSwitch").disabled=mapBtn.disabled&&!mapViewShown();
  ["addFolder","saveRemixes","saveLive","personalPicks","logging","ioWorkers","chooseOrganizeDestination"].forEach(function(id){
    document.getElementById(id).disabled=busy;
  });
  document.getElementById("organizeOnlyBtn").disabled=busy||!organizeDestination;
  const musicBrainzRequests=state.musicBrainzRequests||[];
  if(musicBrainzRequests.length)musicBrainzRequests.forEach(queueMusicBrainzRequest);else clearMusicBrainzRequests();
}
setInterval(function(){
  if(state&&state.running)document.getElementById("progressDetail").textContent=currentDetail();
},1000);

function openModal(kind,title,subtitle,bodyHtml,buttonsHtml){
  modalKind=kind;
  // Re-rendering an already open modal must not replace its original focus target
  // with a now-deleted row button.
  if(!document.getElementById("modalBackdrop").classList.contains("open"))
    modalReturnFocus=document.activeElement;
  document.getElementById("modalTitle").textContent=title||"";
  document.getElementById("modalSubtitle").textContent=subtitle||"";
  document.getElementById("modalTitle").title=subtitle||"";
  document.getElementById("modalBody").innerHTML=bodyHtml||"";
  document.getElementById("modalFoot").innerHTML=buttonsHtml||"";
  document.getElementById("modalBackdrop").classList.add("open");
  requestAnimationFrame(function(){
    const first=document.querySelector("#modal button:not(:disabled),#modal input:not(:disabled),#modal select:not(:disabled),#modal textarea:not(:disabled)");
    if(first) first.focus();
  });
}
function closeModal(){
  modalKind="";
  document.getElementById("modalBackdrop").classList.remove("open");
  if(modalReturnFocus&&typeof modalReturnFocus.focus==="function") modalReturnFocus.focus();
  modalReturnFocus=null;
}
document.addEventListener("keydown",function(e){
