    function mk(cls,icon,title,onclick){
      const b=document.createElement("button");b.className="iconBtn "+cls;b.innerHTML=icon;b.title=title;b.setAttribute("aria-label",title);
      b.disabled=busy;b.onclick=onclick;return b;
