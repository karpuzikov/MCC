def _new_log(kind):
    """Create a collision-proof, isolated log for one launch/job/undo."""
    log_dir = DATA / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    for _ in range(8):
        name = f"{kind}-{datetime.now():%Y-%m-%d-%H-%M-%S}-{uuid.uuid4().hex[:12]}.log"
        path = log_dir / name
        try:
            with path.open("x", encoding="utf-8"):
