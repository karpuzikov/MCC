  [/cd rip logs/i,"disc"],[/classifying/i,"sort"],[/generating chromaprint/i,"fingerprint"],
  [/indexing fingerprints/i,"fingerprint"],[/finding audio candidates|comparing audio|alternate masterings|applying manual acoustic decisions/i,"compare"],
