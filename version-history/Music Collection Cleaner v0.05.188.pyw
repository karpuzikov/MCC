    cue_start_seconds: float = 0.0
    cue_end_seconds: float = 0.0
    cue_title: str = ""
    cue_performer: str = ""
    cue_album: str = ""
    # Per-analysis evidence only; raw duration and source files remain intact.
    identity_duration_seconds: float = 0.0

    @property
