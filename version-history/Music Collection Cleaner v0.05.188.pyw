  svg.setAttribute("width","0");svg.setAttribute("height","0");
  const relations=new Map();
  function mark(id,kind,peer){
    const key=String(id);
    if(!relations.has(key))relations.set(key,{kind:kind,labels:new Set()});
    const entry=relations.get(key);
    entry.kind=kind;
    const other=getNode(peer);
    if(other)entry.labels.add(kind+": "+String(other.name||""));
  }
  const selected=selectedId==null?null:Number(selectedId);
  if(viewMode==="full"){
    (state.duplicateLinks||[]).forEach(function(link){
      if(showAllConnections||selected===Number(link.duplicate)||selected===Number(link.retained)){
        mark(link.duplicate,"duplicate",link.retained);
        mark(link.retained,"duplicate",link.duplicate);
      }
    });
    if(selected!=null&&!activeTrack){
      const related=baseRelationsForRelease(selected);
      [["version",related.versions],["remix",related.remixes],["live",related.live]].forEach(([kind,ids])=>{
        ids.forEach(id=>{mark(id,kind,selected);mark(selected,kind,id);});
