      function(){const rows=folderRows();rows[i].star=!rows[i].star;pushFolders(rows);});
    star.setAttribute("aria-pressed",folder.star?"true":"false");
    const label=document.createElement("label");label.className="roleLabel";label.setAttribute("for","folderPath"+i);label.textContent=role;
    const input=document.createElement("input");input.id="folderPath"+i;input.className="field path";
