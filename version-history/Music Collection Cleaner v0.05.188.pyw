#choiceStatus[aria-busy="true"]::before { content:""; display:inline-block; width:.65em; height:.65em; border:2px solid currentColor; border-right-color:transparent; border-radius:50%; margin-inline-end:var(--space-1); animation:choice-spin .75s linear infinite; }
@keyframes choice-spin { to { transform:rotate(1turn); } }
body.updatingReleases .releaseRow { animation:release-wave 1.4s ease-in-out infinite; animation-delay:calc(var(--wave-row,0) * 45ms); }
body.updatingReleases .releaseGroupTitle { animation:release-wave-title 1.4s ease-in-out infinite; animation-delay:calc(var(--wave-row,0) * 45ms); }
@keyframes release-wave { 0%,60%,100% { background:transparent; } 30% { background:color-mix(in srgb,var(--primary) 22%,transparent); } }
@keyframes release-wave-title { 0%,60%,100% { color:var(--ink); } 30% { color:var(--primary); } }
@media (prefers-reduced-motion: reduce) { #choiceStatus::before,body.updatingReleases .releaseRow,body.updatingReleases .releaseGroupTitle { animation:none!important; } }
html[data-embedded] #toolbar { display:none; }
