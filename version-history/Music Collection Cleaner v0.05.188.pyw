def _clear_previous_run_logs() -> None:
    """A new scan starts a new run: the logs folder keeps only this run's logs."""
    root = _logs_dir()
    if not root.is_dir():
        return
    for old_log in root.iterdir():
        if old_log.is_file():
            try:
                old_log.unlink()
            except OSError:
                pass  # shortcut: a log open in another program stays until the next run


def _new_comparison_log_path(recycle: Path) -> Path:
    """The one comparison log of this run."""
    _migrate_legacy_app_data()
    root = _logs_dir()
    try:
        root.mkdir(parents=True, exist_ok=True)
        return root / f"{APP_NAME} Comparison.jsonl"
    except Exception as exc:
        raise RuntimeError(f"Could not create comparison log: {exc}") from exc


